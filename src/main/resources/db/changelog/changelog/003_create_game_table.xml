<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="grisha.tech">
        <createTable tableName="games">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="location" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="game_link" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="game_time" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="total_slots" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="level" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="organizer_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_games_organizer"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="grisha.tech">
        <createTable tableName="game_participants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="game_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_game_participants_game"
                             referencedTableName="games"
                             referencedColumnNames="id"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_game_participants_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="joined_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>